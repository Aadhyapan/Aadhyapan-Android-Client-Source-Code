<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/colorAccent" android:id="@+id/school" android:background="#f5f5f5" android:layout_width="150dp" android:layout_height="100dp" android:layout_marginTop="150dp" android:text="School" android:drawableTop="@drawable/ic_school" android:drawablePadding="8dp" android:layout_alignParentTop="true" android:lineSpacingExtra="8sp" android:textAlignment="center" android:layout_marginStart="26dp" android:layout_alignParentStart="true" style="@style/Widget.AppCompat.Button"/>

    <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/colorAccent" android:id="@+id/teacher" android:background="#f5f5f5" android:layout_width="150dp" android:layout_height="100dp" android:layout_marginTop="260dp" android:text="Teacher" android:drawableTop="@drawable/ic_teacher" android:drawablePadding="8dp" android:layout_alignParentTop="true" android:lineSpacingExtra="16sp" android:textAlignment="center" android:layout_marginStart="26dp" android:layout_alignParentStart="true" style="@style/Widget.AppCompat.Button"/>

    <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/colorAccent" android:id="@+id/student" android:background="#f5f5f5" android:layout_width="150dp" android:layout_height="100dp" android:text="Student" android:drawableTop="@drawable/ic_student" android:drawablePadding="8dp" android:layout_alignTop="@+id/school" android:lineSpacingExtra="8sp" android:textAlignment="center" android:layout_marginEnd="22dp" android:layout_alignParentEnd="true" style="@style/Widget.AppCompat.Button"/>

    <!-- Test Buttons -->
    <Button android:textSize="13sp" android:textStyle="bold" android:textColor="@android:color/white" android:id="@+id/btnSchoolTest" android:background="@color/colorPrimary" android:layout_width="150dp" android:layout_height="38dp" android:layout_marginTop="370dp" android:text="School Test" android:layout_alignParentTop="true" android:layout_marginStart="26dp" android:layout_alignParentStart="true" style="@style/Widget.AppCompat.Button"/>

    <Button android:textSize="13sp" android:textStyle="bold" android:textColor="@android:color/white" android:id="@+id/btnTeacherTest" android:background="@color/colorPrimary" android:layout_width="150dp" android:layout_height="38dp" android:layout_marginTop="414dp" android:text="Teacher Test" android:layout_alignParentTop="true" android:layout_marginStart="26dp" android:layout_alignParentStart="true" style="@style/Widget.AppCompat.Button"/>

    <Button android:textSize="13sp" android:textStyle="bold" android:textColor="@android:color/white" android:id="@+id/btnStudentTest" android:background="@color/colorPrimary" android:layout_width="150dp" android:layout_height="38dp" android:text="Student Test" android:layout_alignTop="@+id/btnSchoolTest" android:layout_marginEnd="22dp" android:layout_alignParentEnd="true" style="@style/Widget.AppCompat.Button"/>

    <ImageView android:id="@+id/imageView2" android:layout_width="110dp" android:layout_height="110dp" android:layout_marginTop="15dp" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" android:contentDescription="Logo" app:srcCompat="@mipmap/logo"/>

    <TextView
        android:id="@+id/tvFooterDeveloper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Developed by Raman Chapagain"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />
</RelativeLayout>
